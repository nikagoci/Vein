# Vein does not read this file. Export these in your shell, never commit a real key:
#   export OPENROUTER_API_KEY=...
OPENROUTER_API_KEY=
# Optional: model id on OpenRouter (default google/gemini-3.8-flash)
VEIN_MODEL=
# Optional: 1 = deterministic fake model, no key, no network (the tests always use it)
VEIN_OFFLINE=
# Optional: 1 = demo.py option 5 answers with the model
VEIN_LIVE=
